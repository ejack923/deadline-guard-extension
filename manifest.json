{
  "manifest_version": 3,
  "name": "Deadline Guard ATLAS Capture",
  "version": "0.1.0",
  "description": "Captures ATLAS page state and submits normalized imports to Deadline Guard backend.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:54322/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Deadline Guard",
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content/atlas-page.ts"],
      "run_at": "document_idle"
    }
  ]
}
